@model NerdDinner.Models.RegisterExternalLoginModel
@{
    ViewBag.Title = "Register";
}

<hgroup class="title">
    <h1>@ViewBag.Title.</h1>
    <h2>Associate your @ViewBag.ProviderDisplayName account.</h2>
</hgroup>

<form asp-action="ExternalLoginConfirmation" asp-route-returnUrl="@ViewBag.ReturnUrl" method="post">
    <div asp-validation-summary="ModelOnly"></div>

    <fieldset>
        <legend>Association Form</legend>
        <p>
            You've successfully authenticated with <strong>@ViewBag.ProviderDisplayName</strong>.
            Please enter a user name for this site below and click the Confirm button to finish
            logging in.
        </p>
        <ol>
            <li class="name">
                <label asp-for="UserName"></label>
                <input asp-for="UserName" />
                <span asp-validation-for="UserName"></span>
            </li>
        </ol>
        <input type="submit" value="Register" />
    </fieldset>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
