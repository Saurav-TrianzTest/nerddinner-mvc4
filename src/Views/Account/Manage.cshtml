@model NerdDinner.Models.LocalPasswordModel
@{
    ViewBag.Title = "Manage Account";
}

<hgroup class="title">
    <h1>@ViewBag.Title.</h1>
</hgroup>

<p class="message-success">@ViewBag.StatusMessage</p>

<p>You're logged in as <strong>@User.Identity.Name</strong>.</p>

@if (ViewBag.HasLocalPassword)
{
    <partial name="_ChangePasswordPartial" model="Model" />
}
else
{ 
    <partial name="_SetPasswordPartial" model="Model" />
}

<section id="externalLogins">
    @await Component.InvokeAsync("RemoveExternalLogins")

    <h3>Add an external login</h3>
    @await Component.InvokeAsync("ExternalLoginsList", new { returnUrl = (string)ViewBag.ReturnUrl })
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
