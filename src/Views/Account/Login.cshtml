@model NerdDinner.Models.LoginModel

@{
    ViewBag.Title = "Log in";
}

<hgroup class="title">
    <h1>@ViewBag.Title.</h1>
</hgroup>

<section id="loginForm">
<h2>Use a local account to log in.</h2>
<form asp-action="Login" asp-route-returnUrl="@ViewBag.ReturnUrl" method="post">
    <div asp-validation-summary="ModelOnly"></div>

    <fieldset>
        <legend>Log in Form</legend>
        <ol>
            <li>
                <label asp-for="UserName"></label>
                <input asp-for="UserName" />
                <span asp-validation-for="UserName"></span>
            </li>
            <li>
                <label asp-for="Password"></label>
                <input asp-for="Password" />
                <span asp-validation-for="Password"></span>
            </li>
            <li>
                <input asp-for="RememberMe" />
                <label asp-for="RememberMe" class="checkbox"></label>
            </li>
        </ol>
        <input type="submit" value="Log in" />
    </fieldset>
    <p>
        <a asp-action="Register">Register</a> if you don't have an account.
    </p>
</form>
</section>

<section class="social" id="socialLoginForm">
    <h2>Use another service to log in.</h2>
    @await Component.InvokeAsync("ExternalLoginsList", new { returnUrl = (string)ViewBag.ReturnUrl })
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
