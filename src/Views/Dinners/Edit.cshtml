@model NerdDinner.Models.Dinner

@{
    ViewBag.Title = "Host a Nerd Dinner";
}

<h2>Host a Dinner</h2>

<form asp-action="Edit" asp-route-id="@Model.DinnerID" method="post">
    <div asp-validation-summary="ModelOnly"></div>

    <fieldset>
        <legend></legend>
        @Html.HiddenFor(model => model.DinnerID)
        <div id="dinnerDiv" style="float: right;">
            <div class="editor-label">
                <label asp-for="Title"></label>
            </div>
            <div class="editor-field">
                @Html.EditorFor(model => model.Title)
                <span asp-validation-for="Title"></span>
            </div>

            <div class="editor-label">
                <label asp-for="EventDate"></label>
            </div>
            <div class="editor-field">
                @Html.EditorFor(model => model.EventDate)
                <span asp-validation-for="EventDate"></span>
            </div>

            <div class="editor-label">
                <label asp-for="Description"></label>
            </div>
            <div class="editor-field">
                @Html.EditorFor(model => model.Description)
                <span asp-validation-for="Description"></span>
            </div>

            <div class="editor-label">
                <label asp-for="HostedBy"></label>
            </div>
            <div class="editor-field">
                @Html.DisplayFor(model => model.HostedBy)
            </div>

            <div class="editor-label">
                <label asp-for="ContactPhone"></label>
            </div>
            <div class="editor-field">
                @Html.EditorFor(model => model.ContactPhone)
                <span asp-validation-for="ContactPhone"></span>
            </div>

            <div class="editor-label">
                <label asp-for="Address"></label>
            </div>
            <div class="editor-field">
                @Html.EditorFor(model => model.Address)
                <span asp-validation-for="Address"></span>
            </div>

            <div class="editor-label">
                <label asp-for="Country"></label>
            </div>
            <div class="editor-field">
                @Html.EditorFor(model => model.Country)
                <span asp-validation-for="Country"></span>
            </div>
        </div>
        <div id="mapDiv" style="float: left;">
            @Html.EditorFor(model => model.Location)
            @Html.EditorFor(model => model.LocationDetail)
        </div>
        <p>
            <input type="submit" value="Save" />
        </p>
    </fieldset>
</form>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script type="text/javascript">
        $(document).ready(function () {
            $("#Address").blur(function (evt) {
                // When it's time to look for an address, clear out the previous location
                $("#Location").val("");
                var address = jQuery.trim($("#Address").val());
                if (address.length < 1)
                    return;
                NerdDinner.FindAddressOnMap(address);
            });
        });
    </script>
}
