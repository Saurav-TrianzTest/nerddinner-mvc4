@model NerdDinner.Models.Dinner
<script type="text/javascript">

	function AnimateRSVPMessage() {
		$("#rsvpmsg").animate({ fontSize: "1.5em" }, 400);
	}

</script>
<div id="rsvpmsg">
	@if (User.Identity != null && User.Identity.IsAuthenticated)
	{
		if (Model.IsHostedBy(User.Identity.Name))
		{ 

		<p>
			You are the host for this event!
		</p>

		}
		else if (Model.IsUserRegistered(User.Identity.Name))
		{
	
		<p>
			You are registered for this event!
		</p>
	
		<a asp-controller="RSVP" asp-action="CancelAjax" asp-route-id="@Model.DinnerID"
		   data-ajax="true" data-ajax-method="POST" data-ajax-update="#rsvpmsg" data-ajax-success="AnimateRSVPMessage">Cancel your RSVP</a>
	
		}
		else
		{ 

		<a asp-controller="RSVP" asp-action="RegisterAjax" asp-route-id="@Model.DinnerID"
		   data-ajax="true" data-ajax-method="POST" data-ajax-update="#rsvpmsg" data-ajax-success="AnimateRSVPMessage">RSVP for this event</a>
		}
	}
	else
	{
		<a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Url.Action("Details", "Dinners", new { id = Model.DinnerID })">RSVP for this event</a>
	}
</div>
