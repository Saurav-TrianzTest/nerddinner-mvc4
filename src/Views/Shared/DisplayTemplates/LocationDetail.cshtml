@model NerdDinner.Models.LocationDetail
@{
    var detail = new
    {
        lat = Model.Location?.Y ?? 0,
        lng = Model.Location?.X ?? 0,
        id = Model.Id.ToString(),
        title = Model.Title,
        address = Model.Address
    };
}
<div id="theMap" style="position: relative; width: 400px; height: 400px; border: solid 1px #bbd1ec;">
</div>

<script type="text/javascript">
    $(document).ready(function () {
        var detail = @Json.Serialize(detail);

        if ((detail.lat != 0) && (detail.lng != 0)){
            NerdDinner.LoadMap(detail.lat, detail.lng);
            NerdDinner.LoadPin(new Microsoft.Maps.Location(detail.lat, detail.lng), detail.id, detail.title, detail.address, false);

            NerdDinner._map.setView({zoom:14});
        }
        else {
            NerdDinner.LoadMap(null, null);
        }
    });
</script>
