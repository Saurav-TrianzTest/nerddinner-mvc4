@if (User.Identity != null && User.Identity.IsAuthenticated) {
    <text>
        Hello, <a asp-controller="Account" asp-action="Manage" class="username" title="Manage">@User.Identity.Name</a>!
        <form asp-controller="Account" asp-action="LogOff" method="post" id="logoutForm" style="display: inline;">
            <a href="javascript:document.getElementById('logoutForm').submit()">Log off</a>
        </form>
    </text>
} else {
    <ul>
        <li><a asp-controller="Account" asp-action="Register" id="registerLink">Register</a></li>
        <li><a asp-controller="Account" asp-action="Login" id="loginLink">Log in</a></li>
    </ul>
}
